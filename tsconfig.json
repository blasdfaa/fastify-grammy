{
  "compilerOptions": {
    "target": "ES2023",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": [
      "node"
    ],
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "esModuleInterop": true,
    "skipLibCheck": true
  },
  "include": [
    "src",
    "test",
    "playground"
  ]
}
