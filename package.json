{
  "name": "fastify-grammy",
  "type": "module",
  "version": "0.2.0",
  "packageManager": "pnpm@12.15.0",
  "description": "Scoped grammY bot integration with Fastify lifecycle, polling, and webhooks.",
  "author": "Viktor Zdorovtsev",
  "license": "MIT",
  "homepage": "https://github.com/blasdfaa/fastify-grammy#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/blasdfaa/fastify-grammy.git"
  },
  "bugs": {
    "url": "https://github.com/blasdfaa/fastify-grammy/issues"
  },
  "keywords": [
    "fastify",
    "fastify-plugin",
    "grammy",
    "telegram",
    "bot",
    "webhook"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "CHANGELOG.md",
    "dist",
    "docs/migration-0.2.0.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup src/index.ts --dts --format esm,cjs --target node22 --clean && node scripts/finalize-build.mjs",
    "dev": "vitest",
    "lint": "eslint .",
    "hooks:install": "lefthook install",
    "check": "pnpm build && pnpm lint && pnpm test:unit && pnpm test:types && pnpm test:package",
    "prepack": "pnpm build",
    "prepublishOnly": "pnpm check",
    "release": "pnpm check && bumpp --no-push && npm publish",
    "release:notes": "changelogithub",
    "test": "pnpm build && pnpm test:unit && pnpm test:types && pnpm test:package",
    "test:unit": "vitest run",
    "test:types": "tsc --noEmit",
    "test:package": "publint && pnpm test:consumer",
    "test:consumer": "node scripts/test-consumers.mjs"
  },
  "peerDependencies": {
    "fastify": "^5.0.0"
  },
  "dependencies": {
    "@fastify/error": "^4.2.1",
    "@types/node-fetch": "^2.6.13",
    "fastify-plugin": "^6.0.1",
    "grammy": "^1.46.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "10.0.0",
    "@types/node": "22.20.5",
    "bumpp": "12.3.0",
    "changelogithub": "15.0.5",
    "eslint": "10.13.0",
    "fastify": "5.12.7",
    "lefthook": "2.2.2",
    "node-fetch": "2.7.0",
    "publint": "0.3.25",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
